# Copy this file to .env and fill it in. Never share or commit .env.

# ---- Your collection (filled in for moemoe LLC as an example: change these 4 lines) ----
# The chain it's on: ethereum, base, arbitrum, optimism, polygon, abstract, apechain, berachain,
# megaeth, monad, hyperevm, ink, mantle, zora, shape, unichain, soneium, avalanche, sei, robinhood.
# Another EVM chain: its chain ID number, plus RPC_URL= (and NATIVE_SYMBOL= if its coin isn't ETH).
CHAIN=ethereum
# Its contract address (Etherscan, or the "Contract address" on its OpenSea page)
CONTRACT_ADDRESS=0x06f97e756f5c7ac0db75411101bd09e17f63aba7
# Shown in each post. Leave COLLECTION_NAME empty to use the name the contract reports.
COLLECTION_NAME=moemoe LLC
EMOJI=🎀

# ---- X (Twitter) API keys: developer.x.com -> your app -> "Keys and tokens" ----
# The Access Token must be generated while logged in as the BOT account, with
# "Read and write" permission (regenerate it after changing permissions).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# true = print posts instead of posting them.
# Set to false once `python bot.py --check` passes.
DRY_RUN=true
